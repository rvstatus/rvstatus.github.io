generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model t_admin {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  email       String    @db.VarChar(150)
  password    String    @db.VarChar(255)
  created_by  String    @db.VarChar(100)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  updated_by  String?   @default("") @db.VarChar(100)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
  deleted_flg Int       @default(0)
}

model t_booking {
  id               Int       @id @default(autoincrement())
  customer_id      String    @db.VarChar(150)
  event_date       DateTime  @db.Date
  event_type       String    @db.VarChar(100)
  number_of_guests Int?
  requirements     String?   @db.Text
  booking_status   Int       @default(0)
  approve_by       String?   @db.VarChar(50)
  approve_at       DateTime? @db.Timestamp(0)
  created_by       String    @db.VarChar(50)
  created_at       DateTime  @default(now()) @db.Timestamp(0)
  updated_by       String?   @db.VarChar(50)
  updated_at       DateTime? @default(now()) @db.Timestamp(0)
  deleted_flg      Int       @default(0)
}

model t_customer {
  id            Int       @id @default(autoincrement())
  customer_id   String    @db.VarChar(150)
  customer_name String    @db.VarChar(150)
  mobile        String    @db.VarChar(20)
  email         String    @default("") @db.VarChar(150)
  created_by    String    @db.VarChar(50)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_by    String?   @db.VarChar(50)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  deleted_flg   Int       @default(0)
}

model t_customer_message {
  id          Int       @id @default(autoincrement())
  customer_id String    @db.VarChar(150)
  message     String    @db.Text
  created_by  String    @db.VarChar(50)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  updated_by  String?   @db.VarChar(50)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
  deleted_flg Int       @default(0)
}
