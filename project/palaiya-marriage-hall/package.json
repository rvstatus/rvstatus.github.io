{
  "name": "palaiya-marriage-hall",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "yarn install",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "dev": "concurrently \"yarn dev:web\" \"yarn dev:api\"",
    "dev:web": "webpack serve --config webpack.web.config.js --mode development",
    "dev:api": "tsx src/api/server.ts",
    "build": "yarn build:web && yarn build:api",
    "build:web": "webpack --config webpack.web.config.js --mode production",
    "build:api": "tsc",
    "start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "mariadb": "3.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/node": "22.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "9.1.2",
    "html-webpack-plugin": "5.6.8",
    "nodemon": "3.1.9",
    "prisma": "7.9.1",
    "ts-loader": "9.6.2",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  }
}
